<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<!--Pure CSS Magic to disable Google button until a radio is selected -->
<style>
  /* Form is 'invalid' because required radio is not checked */
  .google-auth-form:invalid .google-btn {
    opacity: 0.5;
    pointer-events: none;
    cursor: not-allowed;
  }

  .google-auth-form:valid .google-btn {
    opacity: 1;
    pointer-events: auto;
    cursor: pointer;
  }
</style>

<main class="page-shell container mx-auto py-12">
  <section class="max-w-2xl mx-auto rounded-[1.75rem] bg-slate-50 dark:bg-slate-900 shadow-[0_24px_64px_rgba(15,23,42,0.08)] p-10">
    <div class="text-center mb-8 mt-4">
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white mb-4">Welcome to NestStay</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm md:text-base max-w-md mx-auto leading-relaxed">
        Log in to book your next getaway, manage upcoming reservations, and explore your saved favorites.
      </p>
    </div>

  
    <form action="/login" method="POST" class="space-y-5">
      <%- include('../partials/errors') %>
      
      <div class="field-group mb-2">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" placeholder="you@example.com" value="<%= typeof oldInput !== 'undefined' && oldInput.email ? oldInput.email : '' %>" required />
      </div>

      <div class="field-group mb-2">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="Enter your password" required />
      </div>

      <button type="submit" class="btn-primary w-full">Sign in</button>
    </form>

  
    <div class="flex items-center justify-center gap-3 text-slate-400 my-6 mb-2">
      <span class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></span>
      <span class="text-sm">or</span>
      <span class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></span>
    </div>

    <form action="/auth/google" method="GET" class="space-y-5 google-auth-form">
      
      
      <div style="border: 1px solid var(--border); border-radius: 1.25rem; padding: 1.25rem; background: transparent;">
        <p style="font-size: 0.95rem; font-weight: 600; color: var(--text); margin-bottom: 1rem; text-align: left;">
          I want to log in as:
        </p>
        
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          
          <label style="display: flex; align-items: center; justify-content: center; gap: 0.6rem; padding: 1rem; border: 1px solid var(--border); border-radius: 0.85rem; cursor: pointer; transition: all 0.2s; background: transparent;" class="hover:bg-slate-100 dark:hover:bg-slate-800">
            <input type="radio" name="userType" value="guest" style="accent-color: var(--accent); width: 1.2rem; height: 1.2rem; cursor: pointer;" required <%= typeof oldInput !== 'undefined' && oldInput.userType === 'guest' ? 'checked' : '' %> />
            <span style="font-weight: 600; color: var(--text);">Guest</span>
          </label>
          
          <label style="display: flex; align-items: center; justify-content: center; gap: 0.6rem; padding: 1rem; border: 1px solid var(--border); border-radius: 0.85rem; cursor: pointer; transition: all 0.2s; background: transparent;" class="hover:bg-slate-100 dark:hover:bg-slate-800">
            <input type="radio" name="userType" value="host" style="accent-color: var(--accent); width: 1.2rem; height: 1.2rem; cursor: pointer;" required <%= typeof oldInput !== 'undefined' && oldInput.userType === 'host' ? 'checked' : '' %> />
            <span style="font-weight: 600; color: var(--text);">Host</span>
          </label>
          
        </div>
      </div>

      <button type="submit" class="btn-secondary w-full flex items-center justify-center gap-3 google-btn" style="min-height: 3.2rem; border-radius: 1rem; margin-top: 1.25rem;">
        <i class="fab fa-google text-lg mr-2"></i>
        Continue with Google
      </button>
      
    </form>
    <p class="mt-6 text-center text-slate-500 dark:text-slate-400">Don’t have an account? <a href="/signup" class="text-accent hover:underline">Sign up</a></p>
  </section>
</main>



</body>
</html>