<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="container mx-auto py-10 px-4">
  <div class="mb-8">
    <p class="text-sm uppercase tracking-[0.35em] text-slate-500">Admin Control</p>
    <h1 class="text-3xl font-black text-slate-900 dark:text-white mt-1">Manage Pending Hosts</h1>
    <p class="text-slate-600 dark:text-slate-400 text-sm mt-1">Review and approve host accounts to grant them dashboard access.</p>
  </div>

  <% if (pendingHosts && pendingHosts.length > 0) { %>
    <!-- FIX: bg-white ki jagah bg-slate-50 dark:bg-slate-900 use kiya hai -->
    <div class="bg-slate-50 dark:bg-slate-900 shadow-md rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-200/50 dark:bg-slate-800/50 text-slate-700 dark:text-slate-300 text-xs uppercase tracking-wider">
              <th class="p-4 font-bold">Host Name</th>
              <th class="p-4 font-bold">Email Address</th>
              <th class="p-4 font-bold text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
            <% pendingHosts.forEach(host => { %>
              <tr class="hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                <td class="p-4 font-semibold text-slate-900 dark:text-white">
                  <%= host.firstName %> <%= host.lastName %>
                </td>
                <td class="p-4 text-slate-600 dark:text-slate-400">
                  <%= host.email %>
                </td>
                <td class="p-4 text-right">
                  <form action="/admin/approve-host" method="POST" class="inline-block">
                    <input type="hidden" name="hostId" value="<%= host._id %>">
                    <button type="submit" class="btn-primary px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg shadow transition">
                      Approve Host
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="empty-state mt-8">
      <div class="text-4xl mb-3">🎉</div>
      <h2>No pending host requests</h2>
      <p>All host accounts have been verified or no new signups are waiting.</p>
    </div>
  <% } %>
</main>

</body>
</html>