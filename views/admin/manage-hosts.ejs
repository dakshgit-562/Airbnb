<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="container mx-auto py-10 px-4">
  <div class="flex flex-col md:flex-row md:justify-between md:items-center mb-6 gap-4">
    <div>
      <p class="text-sm uppercase tracking-[0.35em] text-slate-500">Admin Control</p>
      <h1 class="text-3xl font-black text-slate-900 dark:text-white mt-1">Manage Pending Hosts</h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm mt-1">Review, approve, or cancel host accounts.</p>
    </div>
    
    <% if (pendingHosts && pendingHosts.length > 0) { %>
      <form action="/admin/clear-all-hosts" method="POST">
        <button type="submit" class="btn-danger font-semibold px-5 py-2 rounded-lg" onclick="return confirm('Are you sure you want to clear ALL pending host requests?')">
          Clear All Requests
        </button>
      </form>
    <% } %>
  </div>

  <% if (pendingHosts && pendingHosts.length > 0) { %>
    <div class="bg-white dark:bg-slate-800 shadow-md rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-100 dark:bg-slate-700/50 text-slate-700 dark:text-slate-200 text-xs uppercase tracking-wider">
            <th class="p-4 font-bold">Host Name</th>
            <th class="p-4 font-bold">Email Address</th>
            <th class="p-4 font-bold text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <% pendingHosts.forEach(host => { %>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition">
              <td class="p-4 font-semibold text-slate-900 dark:text-white">
                <%= host.firstName %> <%= host.lastName %>
              </td>
              <td class="p-4 text-slate-600 dark:text-slate-300">
                <%= host.email %>
              </td>
              <td class="p-4 text-right flex justify-end gap-2">
                <form action="/admin/approve-host" method="POST" class="inline-block">
                  <input type="hidden" name="hostId" value="<%= host._id %>">
                  <button type="submit" class="btn-primary text-xs px-4 py-2">
                    Approve
                  </button>
                </form>
                
                <form action="/admin/reject-host" method="POST" class="inline-block">
                  <input type="hidden" name="hostId" value="<%= host._id %>">
                  <button type="submit" class="btn-danger text-xs px-4 py-2">
                    Cancel
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-10 text-center shadow-sm mt-4">
      <div class="text-4xl mb-3">🎉</div>
      <h2 class="text-lg font-bold text-slate-800 dark:text-white">No pending host requests</h2>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">All host accounts have been verified.</p>
    </div>
  <% } %>
</main>

</body>
</html>