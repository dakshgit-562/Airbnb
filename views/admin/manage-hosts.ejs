<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page-shell container mx-auto py-10 px-4">
  
  <!-- Header with Clear All Button -->
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; gap: 1rem;">
    
    <h1 style="font-size: 1.875rem; font-weight: bold; color: var(--text); margin: 0;">
      Manage Pending Hosts
    </h1>
    
    <% if (pendingHosts && pendingHosts.length > 0) { %>
      <form action="/admin/clear-all-hosts" method="POST">
        <!-- 🚨 FIXED: Yahan btn-danger class use ki hai jo style.css me pehle se hai -->
        <button type="submit" class="btn-danger" style="padding: 0.6rem 1.5rem; border-radius: 0.5rem; font-weight: 600;" onclick="return confirm('Are you sure you want to clear ALL pending host requests?')">
          Clear All Requests
        </button>
      </form>
    <% } %>
  </div>

  <% if (pendingHosts && pendingHosts.length > 0) { %>
    <!-- 🚨 FIXED: bg-white ko hatakar var(--surface) lagaya, ab Dark Mode perfect chalega -->
    <div class="admin-table-wrap" style="background-color: var(--surface); border: 1px solid var(--border); border-radius: 1rem; overflow: hidden; box-shadow: var(--card-shadow);">
      <!-- 🚨 FIXED: Table ko 100% width di aur elements ko align kiya -->
      <table style="width: 100%; border-collapse: collapse; text-align: left;">
        
        <thead>
          <tr style="background-color: var(--surface-muted); color: var(--text); border-bottom: 1px solid var(--border);">
            <th style="padding: 1rem; font-weight: bold;">Name</th>
            <th style="padding: 1rem; font-weight: bold;">Email</th>
            <!-- Action ko right align kiya -->
            <th style="padding: 1rem; font-weight: bold; text-align: right;">Action</th>
          </tr>
        </thead>
        
        <tbody>
          <% pendingHosts.forEach(host => { %>
            <tr style="border-bottom: 1px solid var(--border); color: var(--text); background-color: var(--surface);">
              
              <td style="padding: 1rem; font-weight: 600;"><%= host.firstName %> <%= host.lastName %></td>
              <td style="padding: 1rem;"><%= host.email %></td>
              
              <!-- Buttons ko right align kiya -->
              <td style="padding: 1rem; text-align: right; white-space: nowrap;">
                
                <!-- Approve Button -->
                <form action="/admin/approve-host" method="POST" style="display: inline-block; margin-right: 0.5rem;">
                  <input type="hidden" name="hostId" value="<%= host._id %>">
                  <button type="submit" class="btn-primary" style="padding: 0.4rem 1rem; min-height: 0; border-radius: 0.4rem;">
                    Approve
                  </button>
                </form>
                
                <!-- Cancel Button -->
                <form action="/admin/reject-host" method="POST" style="display: inline-block;">
                  <input type="hidden" name="hostId" value="<%= host._id %>">
                  <button type="submit" class="btn-danger" style="padding: 0.4rem 1rem; min-height: 0; border-radius: 0.4rem;">
                    Cancel
                  </button>
                </form>

              </td>
            </tr>
          <% }) %>
        </tbody>

      </table>
    </div>
  <% } else { %>
    <p style="color: var(--muted); text-align: center; margin-top: 2rem; font-size: 1.1rem;">No pending host requests right now.</p>
  <% } %>
</main>

</body>
</html>