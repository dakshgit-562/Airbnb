<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="container mx-auto py-10 px-4">
  
  <!-- Header with Clear All Button -->
  <div class="flex flex-col md:flex-row md:justify-between md:items-center mb-6 gap-4">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Manage Pending Hosts</h1>
    
    <% if (pendingHosts && pendingHosts.length > 0) { %>
      <form action="/admin/clear-all-hosts" method="POST">
        <button type="submit" class="bg-red-600 text-white px-5 py-2 font-semibold rounded hover:bg-red-700 transition" onclick="return confirm('Are you sure you want to clear ALL pending host requests?')">
          Clear All Requests
        </button>
      </form>
    <% } %>
  </div>

  <% if (pendingHosts && pendingHosts.length > 0) { %>
    <div class="bg-white dark:bg-slate-800 shadow rounded-lg overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200">
            <th class="p-4">Name</th>
            <th class="p-4">Email</th>
            <th class="p-4 text-right">Action</th>
          </tr>
        </thead>
        <tbody>
          <% pendingHosts.forEach(host => { %>
            <tr class="border-t border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-100">
              <td class="p-4 font-semibold"><%= host.firstName %> <%= host.lastName %></td>
              <td class="p-4"><%= host.email %></td>
              <td class="p-4 text-right space-x-2">
                
                <!-- Approve Button -->
                <form action="/admin/approve-host" method="POST" class="inline-block">
                  <input type="hidden" name="hostId" value="<%= host._id %>">
                  <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition">
                    Approve
                  </button>
                </form>
                
                <!-- Cancel Button -->
                <form action="/admin/reject-host" method="POST" class="inline-block">
                  <input type="hidden" name="hostId" value="<%= host._id %>">
                  <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600 transition">
                    Cancel
                  </button>
                </form>

              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="text-slate-600 dark:text-slate-400">No pending host requests right now.</p>
  <% } %>
</main>

</body>
</html>