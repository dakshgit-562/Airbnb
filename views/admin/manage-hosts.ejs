<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page-shell container mx-auto py-10 px-4">
  
  <!-- 🌟 Header with Clear All Button -->
  <div class="flex flex-col md:flex-row md:justify-between md:items-center mb-6 gap-4">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Manage Hosts</h1>
    
    <% if (pendingHosts && pendingHosts.length > 0) { %>
      <form action="/admin/clear-all-hosts" method="POST">
        <button type="submit" class="btn-danger" onclick="return confirm('Are you sure you want to clear ALL pending host requests?')">
          Clear All Requests
        </button>
      </form>
    <% } %>
  </div>

  <!-- 🔍 Booking Style Backend Search Bar (No Script) -->
  <form action="/admin/manage-hosts" method="GET" class="custom-search-container flex items-center gap-3 mb-6">
    <i class="fas fa-search text-slate-400"></i>
    <!-- name="email" set kiya hai aur searchEmail ki value yahan aayegi -->
    <input type="text" name="email" value="<%= typeof searchEmail !== 'undefined' ? searchEmail : '' %>" 
           class="custom-search-input w-full" placeholder="Search host by email" />
    <button type="submit" style="display: none;">Search</button> <!-- Hidden button for Enter key -->
  </form>

  <!-- 📋 Host Table -->
  <% if (pendingHosts && pendingHosts.length > 0) { %>
    <div class="bg-white dark:bg-slate-800 shadow-md rounded-lg overflow-x-auto border border-slate-200 dark:border-slate-700">
      <table class="w-full text-left border-collapse min-w-[600px]">
        
        <thead>
          <tr class="bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 border-b border-slate-200 dark:border-slate-700">
            <th class="p-4 font-bold">Name & Status</th>
            <th class="p-4 font-bold">Email</th>
            <th class="p-4 text-right font-bold">Action</th>
          </tr>
        </thead>
        
        <tbody id="hostTableBody">
          <% pendingHosts.forEach(host => { %>
            <tr class="host-row border-b border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-100 transition hover:bg-slate-50 dark:hover:bg-slate-700/50">
              
              <td class="p-4 font-semibold">
                <%= host.firstName %> <%= host.lastName %> <br>
                <!-- Status Badges -->
                <% if (host.isVerified) { %>
                  <span class="inline-block mt-1 text-[11px] font-bold bg-green-100 text-green-700 px-2 py-1 rounded-full dark:bg-green-900/30 dark:text-green-400">APPROVED</span>
                <% } else { %>
                  <span class="inline-block mt-1 text-[11px] font-bold bg-amber-100 text-amber-700 px-2 py-1 rounded-full dark:bg-amber-900/30 dark:text-amber-400">PENDING</span>
                <% } %>
              </td>
              
              <td class="host-email p-4"><%= host.email %></td>
              
              <td class="p-4 text-right space-x-2">
                
                <!-- Approve Button (Sirf Pending ke liye) -->
                <% if (!host.isVerified) { %>
                  <form action="/admin/approve-host" method="POST" class="inline-block">
                    <input type="hidden" name="hostId" value="<%= host._id %>">
                    <button type="submit" class="btn-primary px-4 py-2" style="min-height: 2.2rem; border-radius: 0.5rem;">Approve</button>
                  </form>
                <% } %>
                
                <!-- Cancel / Revoke Button (Dono ke liye, Error-Free Logic) -->
                <form action="/admin/reject-host" method="POST" class="inline-block">
                  <input type="hidden" name="hostId" value="<%= host._id %>">
                  <% if (host.isVerified) { %>
                    <button type="submit" class="btn-danger px-4 py-2" style="min-height: 2.2rem; border-radius: 0.5rem;" onclick="return confirm('Are you sure you want to revoke access for this host?')">Revoke Access</button>
                  <% } else { %>
                    <button type="submit" class="btn-danger px-4 py-2" style="min-height: 2.2rem; border-radius: 0.5rem;" onclick="return confirm('Are you sure you want to reject this request?')">Cancel</button>
                  <% } %>
                </form>

              </td>
            </tr>
          <% }) %>
        </tbody>

      </table>
    </div>
  <% } else { %>
    <!-- Empty State (No Hosts / Search Not Found) -->
    <div class="empty-state mt-6">
      <h2 class="text-xl font-bold dark:text-white">No Hosts Found</h2>
      <p class="text-slate-500 dark:text-slate-400">We couldn't find any hosts matching your search, or the list is empty.</p>
    </div>
  <% } %>
</main>

</body>
</html>