<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page-shell container mx-auto py-10 px-4">
  
  <!-- 🌟 Header with Clear All Button (100% Pure CSS Layout) -->
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; gap: 1rem;">
    <h1 style="font-size: 1.875rem; font-weight: bold; color: var(--text); margin: 0;">
      Manage Hosts
    </h1>
    
    <% if (pendingHosts && pendingHosts.length > 0) { %>
      <form action="/admin/clear-all-hosts" method="POST" style="margin: 0;">
        <button type="submit" class="btn-danger" style="padding: 0.6rem 1.5rem; border-radius: 0.5rem; font-weight: 600;" onclick="return confirm('Are you sure you want to clear ALL pending host requests?')">
          Clear All Requests
        </button>
      </form>
    <% } %>
  </div>

  <!-- 🔍 Booking Style Backend Search Bar (No Script, Pure CSS) -->
  <form action="/admin/manage-hosts" method="GET" class="custom-search-container" style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
    <i class="fas fa-search" style="color: var(--muted);"></i>
    <input type="text" name="email" value="<%= typeof searchEmail !== 'undefined' ? searchEmail : '' %>" 
           class="custom-search-input" style="width: 100%; flex-grow: 1;" placeholder="Search host by email and hit Enter..." />
    <button type="submit" style="display: none;">Search</button> 
  </form>

  <!-- 📋 Host Table (100% Pure CSS) -->
  <% if (pendingHosts && pendingHosts.length > 0) { %>
    <div class="admin-table-wrap" style="background-color: var(--surface); border: 1px solid var(--border); border-radius: 1rem; overflow-x: auto; box-shadow: var(--card-shadow);">
      <table style="width: 100%; border-collapse: collapse; text-align: left; min-width: 600px;">
        
        <thead>
          <tr style="background-color: var(--surface-muted); color: var(--text); border-bottom: 1px solid var(--border);">
            <th style="padding: 1rem; font-weight: bold;">Name & Status</th>
            <th style="padding: 1rem; font-weight: bold;">Email</th>
            <th style="padding: 1rem; font-weight: bold; text-align: right;">Action</th>
          </tr>
        </thead>
        
        <tbody>
          <% pendingHosts.forEach(host => { %>
            <tr style="border-bottom: 1px solid var(--border); color: var(--text); background-color: var(--surface);">
              
              <td style="padding: 1rem; font-weight: 600; line-height: 1.4;">
                <%= host.firstName %> <%= host.lastName %> <br>
                <!-- Status Badges -->
                <% if (host.isVerified) { %>
                  <span style="display: inline-block; margin-top: 0.3rem; font-size: 0.7rem; background-color: rgba(16, 185, 129, 0.15); color: #10B981; padding: 0.2rem 0.6rem; border-radius: 999px;">APPROVED</span>
                <% } else { %>
                  <span style="display: inline-block; margin-top: 0.3rem; font-size: 0.7rem; background-color: rgba(245, 158, 11, 0.15); color: #F59E0B; padding: 0.2rem 0.6rem; border-radius: 999px;">PENDING</span>
                <% } %>
              </td>
              
              <td style="padding: 1rem;"><%= host.email %></td>
              
              <td style="padding: 1rem; text-align: right; white-space: nowrap;">
                
                <!-- Approve Button (Sirf Pending ke liye) -->
                <% if (!host.isVerified) { %>
                  <form action="/admin/approve-host" method="POST" style="display: inline-block; margin-right: 0.5rem;">
                    <input type="hidden" name="hostId" value="<%= host._id %>">
                    <button type="submit" class="btn-primary" style="padding: 0.4rem 1rem; min-height: 0; border-radius: 0.4rem;">Approve</button>
                  </form>
                <% } %>
                
                <!-- Cancel / Revoke Button (Dono ke liye, Error-Free Logic) -->
                <form action="/admin/reject-host" method="POST" style="display: inline-block;">
                  <input type="hidden" name="hostId" value="<%= host._id %>">
                  <% if (host.isVerified) { %>
                    <button type="submit" class="btn-danger" style="padding: 0.4rem 1rem; min-height: 0; border-radius: 0.4rem;" onclick="return confirm('Are you sure you want to revoke access for this host?')">Revoke Access</button>
                  <% } else { %>
                    <button type="submit" class="btn-danger" style="padding: 0.4rem 1rem; min-height: 0; border-radius: 0.4rem;" onclick="return confirm('Are you sure you want to reject this request?')">Cancel</button>
                  <% } %>
                </form>

              </td>
            </tr>
          <% }) %>
        </tbody>

      </table>
    </div>
  <% } else { %>
    <!-- Empty State (No Hosts / Search Not Found) -->
    <div style="text-align: center; padding: 3rem 1rem; border: 1px dashed var(--border); border-radius: 1rem; margin-top: 1rem; background-color: var(--surface);">
      <h2 style="font-size: 1.25rem; font-weight: bold; color: var(--text); margin-bottom: 0.5rem;">No Hosts Found</h2>
      <p style="color: var(--muted); font-size: 1rem; margin: 0;">We couldn't find any hosts matching your search, or the list is empty.</p>
    </div>
  <% } %>
</main>

</body>
</html>