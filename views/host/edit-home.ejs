<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page-shell container mx-auto py-10">
  <section class="max-w-3xl mx-auto rounded-[1.75rem] bg-slate-50 dark:bg-slate-900 shadow-[0_24px_64px_rgba(15,23,42,0.08)] p-10">
    <div class="mb-8 text-center">
      <p class="text-sm uppercase tracking-[0.35em] text-slate-500">Property listing</p>
      <h1 class="mt-4 text-4xl font-black text-slate-900 dark:text-white"><%= editing ? 'Edit listing' : 'Add a new home' %></h1>
      <p class="mt-3 text-slate-600 dark:text-slate-400">Enter the details for your property and publish a premium stay.</p>
    </div>

    <!-- Yahan enctype add kiya gaya hai -->
    <form action="/host/<%= editing ? 'edit-home' : 'add-home' %>" method="POST" class="space-y-6" enctype="multipart/form-data">
      <% if (editing) { %>
        <input type="hidden" name="id" value="<%= home._id %>" />
      <% } %>

      <div class="field-group">
        <label for="houseName">Home name</label>
        <input id="houseName" name="houseName" type="text" value="<%= editing ? home.houseName : '' %>" placeholder="E.g. Luxe city apartment" required />
      </div>

      <div class="field-grid field-grid-2">
        <div class="field-group">
          <label for="location">Location</label>
          <input id="location" name="location" type="text" value="<%= editing ? home.location : '' %>" placeholder="City, region" required />
        </div>
        <div class="field-group">
          <label for="price">Price per night</label>
          <input id="price" name="price" type="number" value="<%= editing ? home.price : '' %>" placeholder="Rs 0" required min="0" />
        </div>
      </div>

      <div class="field-grid field-grid-2">
        <div class="field-group">
          <label for="rating">Rating</label>
          <input id="rating" name="rating" type="number" step="0.1" value="<%= editing ? home.rating : '' %>" placeholder="4.5" required min="0"/>
        </div>
        <div class="field-group">
          <label for="image">Photo</label>
          <input id="image" name="image" type="file" accept="image/*" <%= editing ? '' : 'required' %> />
          <% if(editing && home.photoUrl) { %>
            <img src="<%= home.photoUrl %>" alt="Home Photo" class="mt-2 max-w-full h-auto" />
          <% } %>
        </div>
      </div>

      <div class="field-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="5" placeholder="Tell guests what makes this stay special" required><%= editing ? home.description : '' %></textarea>
      </div>
      <div class="field-group"> 
          <span class="text-sm font-semibold text-slate-500 uppercase tracking-[0.25em]"> Host Contact (Help) </span>
          <p class="text-base font-semibold text-slate-700 dark:text-slate-200"> 
            📞 <%= home.hostPhone || 'Not Available' %> 
          </p> 
      </div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <button type="submit" class="btn-primary flex-1"><%= editing ? 'Save changes' : 'Add home' %></button>
        <a href="/host/host-home-list" class="btn-secondary flex-1 text-center">Cancel</a>
      </div>
    </form>
  </section>
</main>

</body>
</html>