<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page-shell container mx-auto py-8 px-4 max-w-7xl">
  <!-- Header Section -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 border-b pb-6 border-slate-200 dark:border-slate-700">
    <div>
      <p class="text-sm uppercase tracking-[0.2em] text-slate-500 mb-1">Host dashboard</p>
      <h1 class="text-3xl font-extrabold">Your listed homes</h1>
      <p class="text-slate-500 mt-1">Manage your properties, bookings, and smart listings from one place.</p>
    </div>
    <a href="/host/add-home" class="bg-black hover:bg-slate-800 text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors">Add Home</a>
  </div>

  <% if (registeredHomes.length > 0) { %>
    <!-- Stats Section -->
    <section class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div class="bg-slate-50 dark:bg-slate-900 p-5 rounded-xl border border-slate-200 dark:border-slate-800">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Total properties</p>
        <h2 class="mt-2 text-3xl font-extrabold"><%= registeredHomes.length %></h2>
      </div>
      <div class="bg-slate-50 dark:bg-slate-900 p-5 rounded-xl border border-slate-200 dark:border-slate-800">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Total bookings</p>
        <h2 class="mt-2 text-3xl font-extrabold">0</h2>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Data available when reservations are created.</p>
      </div>
    </section>

    <!-- Properties Grid -->
    <section class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <% registeredHomes.forEach(home => { %>
        <article class="flex flex-col bg-white dark:bg-slate-950 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-slate-200 dark:border-slate-800">
          
          <!-- Image (Clickable for details) -->
          <div class="relative aspect-[4/3] overflow-hidden bg-slate-100 cursor-pointer group" onclick="document.getElementById('details-<%= home._id %>').classList.toggle('hidden')">
            <img class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" src="<%= home.photoUrl || '/images/OIP4.jpg' %>" alt="<%= home.houseName %>" />
            
            <!-- Hover overlay indicator -->
            <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="text-white text-xs font-semibold px-3 py-1.5 border border-white/50 rounded-full backdrop-blur-sm">Click for Details</span>
            </div>
          </div>

          <!-- Card Content -->
          <div class="p-4 flex flex-col flex-grow">
            <!-- Location & Name -->
            <div class="mb-2 cursor-pointer" onclick="document.getElementById('details-<%= home._id %>').classList.toggle('hidden')">
              <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-1 truncate"><%= home.location %></p>
              <h3 class="font-bold text-lg leading-tight truncate text-slate-900 dark:text-white" title="<%= home.houseName %>"><%= home.houseName %></h3>
            </div>

            <!-- Hidden Details Section (Toggled via JS) -->
            <div id="details-<%= home._id %>" class="hidden mb-3 p-3 bg-slate-50 dark:bg-slate-900 rounded-lg text-sm border border-slate-100 dark:border-slate-800">
              <div class="flex justify-between items-center mb-2">
                <span class="text-slate-500">Rating</span>
                <span class="font-semibold"><i class="fas fa-star text-amber-400 mr-1 text-xs"></i><%= home.rating %></span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-500">Price</span>
                <span class="font-medium">Rs <strong class="text-base font-bold"><%= home.price %></strong> / night</span>
              </div>
            </div>

            <!-- Spacer -->
            <div class="flex-grow"></div> 

            <!-- Actions (Compact, Left & Right Aligned) -->
            <div class="flex justify-between items-center pt-3 mt-2 border-t border-slate-100 dark:border-slate-800">
              <a href="/host/edit-home/<%= home._id %>?editing=true" class="text-sm font-semibold text-blue-600 hover:text-blue-800 dark:text-blue-400 px-2 py-1.5 -ml-2 rounded-md hover:bg-blue-50 dark:hover:bg-slate-800 transition-colors">
                <i class="fas fa-edit mr-1 text-xs"></i> Edit
              </a>
              
              <form action="/host/delete-home/<%= home._id %>" method="POST" class="m-0">
                <button type="submit" class="text-sm font-semibold text-red-600 hover:text-red-800 dark:text-red-400 px-2 py-1.5 -mr-2 rounded-md hover:bg-red-50 dark:hover:bg-slate-800 transition-colors" onclick="return confirm('Are you sure you want to delete this home?');">
                  <i class="fas fa-trash-alt mr-1 text-xs"></i> Delete
                </button>
              </form>
            </div>
            
          </div>
        </article>
      <% }) %>
    </section>
  <% } else { %>
    <!-- Empty State -->
    <div class="mt-12 py-16 px-6 text-center bg-slate-50 dark:bg-slate-900 rounded-2xl border border-dashed border-slate-300 dark:border-slate-700">
      <div class="w-16 h-16 mx-auto bg-slate-200 dark:bg-slate-800 rounded-full flex items-center justify-center mb-4">
        <i class="fas fa-home text-2xl text-slate-400"></i>
      </div>
      <h2 class="text-xl font-bold mb-2 text-slate-900 dark:text-white">You haven't listed a property yet.</h2>
      <p class="text-slate-500 max-w-md mx-auto mb-6">Create a beautiful listing and welcome your first guests with a premium property presentation.</p>
      <a href="/host/add-home" class="bg-black hover:bg-slate-800 text-white px-6 py-2.5 rounded-lg font-semibold transition-colors inline-flex items-center">
        <i class="fas fa-plus mr-2 text-sm"></i> Add your first home
      </a>
    </div>
  <% } %>
</main>
</body>
</html>