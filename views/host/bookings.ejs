<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="page-shell container mx-auto py-10 px-4 sm:px-6 lg:px-8 max-w-7xl">
  
  
  <div class="list-heading mb-8">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">Bookings for your properties</h1>
      <p class="text-base text-slate-500 dark:text-slate-400">View guest reservations, manage cancelled stays, and keep your calendar up to date.</p>
    </div>
  </div>
  
  
  <div class="custom-search-container">
    <form action="/host/bookings" method="GET" style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap; max-width: 600px;">
      <input 
        type="text" 
        name="email" 
        value="<%= typeof searchEmail !== 'undefined' ? searchEmail : '' %>" 
        placeholder="Search Guest Email (e.g. daksh@gmail.com)" 
        class="custom-search-input"
        required
      >
      <button type="submit" style="padding: 10px 24px; background-color: #e11d48; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">
        Search
      </button>
      <% if (typeof searchEmail !== 'undefined' && searchEmail !== '') { %>
        <a href="/host/bookings" style="padding: 10px 24px; background-color: #64748b; color: white; text-decoration: none; border-radius: 6px; font-weight: bold; text-align: center;">
          Clear
        </a>
      <% } %>
    </form>
  </div>

  <% if (bookings && bookings.length > 0) { %>
    <section class="mt-8">
      <% bookings.forEach((booking) => { %>
       
        <article class="pro-booking-card">
          
          <!-- Left Image -->
          <div class="pro-image-box">
            <img src="<%= booking.home?.photoUrl || 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=600&q=80' %>" alt="Property Image">
          </div>

          <!-- Right Content -->
          <div class="pro-content-box">
            
            <!-- Header: Title & Status -->
            <div class="pro-header">
              <div class="pro-title-group">
                <h3><%= booking.home?.houseName || 'Premium Property' %></h3>
                <p>Guest: <%= booking.user?.firstName %> <%= booking.user?.lastName || '' %> (<%= booking.user?.email %>)</p>
              </div>
              <div class="pro-badge <%= booking.status === 'cancelled' ? 'cancelled' : 'confirmed' %>">
                <%= booking.status %>
              </div>
            </div>

            <!-- Body: Grid Details -->
            <div class="pro-grid">
              <div class="pro-grid-item">
                <p class="label">Check-in</p>
                <p class="value"><%= booking.checkIn ? booking.checkIn.toDateString() : 'N/A' %></p>
              </div>
              <div class="pro-grid-item">
                <p class="label">Check-out</p>
                <p class="value"><%= booking.checkOut ? booking.checkOut.toDateString() : 'N/A' %></p>
              </div>
              <div class="pro-grid-item">
                <p class="label">Duration</p>
                <p class="value"><%= booking.numberOfNights %> Nights</p>
              </div>
            </div>

            <!-- Footer: Price & Action -->
            <div class="pro-footer">
              <div class="pro-price-group">
                <p class="label">Total Price (Rs <%= booking.pricePerNight %>/night)</p>
                <p class="value">Rs <%= booking.totalPrice %></p>
              </div>
              
              <% if (booking.status !== 'cancelled') { %>
               
                <form action="/host/bookings/cancel/<%= booking._id %>" method="POST" style="margin: 0;">
                  <button type="submit" class="pro-cancel-btn">Cancel Booking</button>
                </form>
              <% } else { %>
                <div style="padding: 10px 24px; background-color: rgba(100, 116, 139, 0.1); border-radius: 6px;">
                  <p style="margin: 0; font-size: 14px; font-weight: bold; color: #64748b;">🚫 Booking Cancelled</p>
                </div>
              <% } %>
            </div>

          </div>
        </article>
      <% }); %>
    </section>
  <% } else { %>
   
    <div style="text-align: center; padding: 60px 20px; background: transparent; border-radius: 12px; border: 1px dashed #4b5563; margin-top: 32px;">
      <h2 style="font-size: 24px; font-weight: bold; margin-bottom: 8px; color: #f9fafb;">No bookings found</h2>
      <p style="color: #9ca3af; margin-bottom: 24px;">Looks like you haven't received any bookings for your properties yet.</p>
    </div>
  <% } %>
</main>

</body>
</html>