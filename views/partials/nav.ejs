<header class="sticky top-0 z-40">
  <nav class="navbar">
    <a href="/" class="nav-brand">
      <span class="brand-mark">N</span>
      <div>
        <span class="block text-xs uppercase tracking-[0.35em] text-slate-500">NestStay</span>
        <span class="block text-lg font-black" id="loop-text">Premium Stays</span>
      </div>
    </a>

    <div class="nav-links">
      <a href="/" class="<%= currentPage === 'index' || currentPage === 'Home' ? 'nav-link active' : 'nav-link' %>">Home</a>
      <% if (isLoggedIn && user) { %>
        <% if (user.userType === 'host') { %>
          <a href="/host/host-home-list" class="<%= currentPage === 'host-homes' ? 'nav-link active' : 'nav-link' %>">Host Dashboard</a>
          <a href="/host/add-home" class="<%= currentPage === 'addHome' ? 'nav-link active' : 'nav-link' %>">Add Home</a>
          <a href="/host/bookings" class="<%= currentPage === 'host-bookings' ? 'nav-link active' : 'nav-link' %>">Host Bookings</a>
        <% } %>
        <% if (user.userType === 'guest') { %>
          <a href="/favourites" class="<%= currentPage === 'favourites' ? 'nav-link active' : 'nav-link' %>">Favourites</a>
          <a href="/bookings" class="<%= currentPage === 'bookings' ? 'nav-link active' : 'nav-link' %>">Bookings</a>
        <% } %>
        
        <% if (user.email === 'dakshchaudhary10009@gmail.com') { %>
          <a href="/admin/manage-hosts" class="<%= currentPage === 'manage-hosts' ? 'nav-link active' : 'nav-link' %>">Manage Hosts</a>
        <% } %>
      <% } %>
    </div>

    <div class="nav-actions">
      <!-- 🌙 Desktop Theme Toggle (मोबाइल पर छुपा दिया है: hidden md:flex) -->
      <button class="theme-toggle hidden md:flex text-slate-800 dark:text-slate-100 p-2 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 transition" type="button" data-theme-toggle aria-label="Toggle dark mode">
        <i class="fas fa-moon dark:hidden"></i>
        <i class="fas fa-sun hidden dark:inline"></i>
      </button>

      <% if (!isLoggedIn) { %>
        <a href="/signup" class="nav-button secondary hidden md:inline-block">Sign Up</a>
        <a href="/login" class="nav-button primary hidden md:inline-block">Login</a>
      <% } else { %>
        <span class="hidden md:inline-flex text-sm font-semibold text-slate-800 dark:text-slate-200">Hi, <%= user.firstName %></span>
        <form action="/logout" method="POST" class="hidden md:inline-block">
          <button type="submit" class="nav-button secondary">Logout</button>
        </form>
      <% } %>

      <!-- 🍔 Mobile Hamburger Button -->
      <button id="mobile-menu-btn" class="mobile-menu-button text-slate-800 dark:text-slate-100" type="button" aria-expanded="false" aria-label="Toggle menu">
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </nav>

  <!-- 🚨 PRO SIDEBAR: Overlay -->
  <div id="sidebar-overlay" class="sidebar-overlay"></div>
  
  <!-- 🚨 PRO SIDEBAR: Menu -->
  <div id="mobile-menu" class="mobile-menu">
    <div class="flex justify-between items-center mb-6">
      <span class="text-xl font-black text-slate-900 dark:text-white uppercase tracking-widest">Menu</span>
      <button id="close-menu-btn" class="text-2xl text-slate-500 hover:text-red-500 transition px-2">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <!-- 🌙 MOBILE Theme Toggle (साइडबार के अंदर) -->
    <div class="mb-4 pb-4 border-b border-slate-200 dark:border-slate-700">
      <button class="w-full flex items-center justify-between p-3 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100 font-semibold" type="button" data-theme-toggle aria-label="Toggle dark mode">
        <span>Dark / Light Mode</span>
        <div>
          <i class="fas fa-moon dark:hidden"></i>
          <i class="fas fa-sun hidden dark:inline"></i>
        </div>
      </button>
    </div>

    <!-- Mobile Links -->
    <div class="flex flex-col gap-3 overflow-y-auto">
      <a href="/" class="nav-link">Home</a>
      <% if (isLoggedIn && user) { %>
        <% if (user.userType === 'host') { %>
          <a href="/host/host-home-list" class="nav-link">Host Dashboard</a>
          <a href="/host/add-home" class="nav-link">Add Home</a>
          <a href="/host/bookings" class="nav-link">Host Bookings</a>
        <% } %>
        <% if (user.userType === 'guest') { %>
          <a href="/favourites" class="nav-link">Favourites</a>
          <a href="/bookings" class="nav-link">Bookings</a>
        <% } %>
        <% if (user.email === 'dakshchaudhary10009@gmail.com') { %>
          <a href="/admin/manage-hosts" class="nav-link text-accent">Manage Hosts</a>
        <% } %>
        
        <div class="mt-4 pt-4 border-t border-slate-200 dark:border-slate-800">
           <p class="text-sm text-slate-500 mb-3 px-2">Signed in as <%= user.firstName %></p>
           <form action="/logout" method="POST">
             <button type="submit" class="btn-danger w-full text-center py-2">Logout</button>
           </form>
        </div>
      <% } else { %>
        <div class="mt-4 pt-4 border-t border-slate-200 dark:border-slate-800 flex flex-col gap-3">
          <a href="/signup" class="btn-secondary w-full text-center py-2">Sign Up</a>
          <a href="/login" class="btn-primary w-full text-center py-2">Login</a>
        </div>
      <% } %>
    </div>
  </div>
</header>

<div class="toast-root" aria-live="polite" aria-atomic="true"></div>

<!-- JavaScript for Sidebar & Text Loop -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // 1. Text Loop Animation
    const texts = ["Premium Stays", "Luxury Villas", "Best Getaways", "Cozy Homes"];
    let index = 0;
    const targetElement = document.getElementById("loop-text");

    if (targetElement) {
      setInterval(() => {
        index = (index + 1) % texts.length;
        targetElement.style.opacity = 0;
        setTimeout(() => {
          targetElement.textContent = texts[index];
          targetElement.style.opacity = 1;
        }, 250);
      }, 2500);
      targetElement.style.transition = "opacity 0.25s ease-in-out";
    }

    // 2. Pro Slide-in Sidebar Logic
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('close-menu-btn');
    const sidebar = document.getElementById('mobile-menu');
    const overlay = document.getElementById('sidebar-overlay');

    function openMenu() {
      if (sidebar && overlay) {
        sidebar.classList.add('open');
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden'; // Scrolling disable
      }
    }

    function closeMenu() {
      if (sidebar && overlay) {
        sidebar.classList.remove('open');
        overlay.classList.remove('open');
        document.body.style.overflow = ''; // Scrolling enable
      }
    }

    if (mobileBtn) mobileBtn.addEventListener('click', openMenu);
    if (closeBtn) closeBtn.addEventListener('click', closeMenu);
    if (overlay) overlay.addEventListener('click', closeMenu);
  });
</script>