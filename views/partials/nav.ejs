<header class="sticky top-0 z-40">
  <nav class="navbar">
    <button class="mobile-menu-button text-slate-800 dark:text-slate-100" type="button" data-mobile-menu-button aria-expanded="false" aria-label="Open menu">
      <i class="fas fa-bars"></i>
    </button>

    <a href="/" class="nav-brand">
      <span class="brand-mark">N</span>
      <div>
        <span class="block text-xs uppercase tracking-[0.35em] text-slate-500">NestStay</span>
        <span class="block text-lg font-black" id="loop-text">Premium Stays</span>
      </div>
    </a>

    <div class="nav-links">
      <a href="/" class="<%= currentPage === 'index' || currentPage === 'Home' ? 'nav-link active' : 'nav-link' %>">Home</a>
      <% if (isLoggedIn && user) { %>
        <% if (user.userType === 'host') { %>
          <a href="/host/host-home-list" class="<%= currentPage === 'host-homes' ? 'nav-link active' : 'nav-link' %>">Host Dashboard</a>
          <a href="/host/add-home" class="<%= currentPage === 'addHome' ? 'nav-link active' : 'nav-link' %>">Add Home</a>
          <a href="/host/bookings" class="<%= currentPage === 'host-bookings' ? 'nav-link active' : 'nav-link' %>">Host Bookings</a>
        <% } %>
        <% if (user.userType === 'guest') { %>
          <a href="/favourites" class="<%= currentPage === 'favourites' ? 'nav-link active' : 'nav-link' %>">Favourites</a>
          <a href="/bookings" class="<%= currentPage === 'bookings' ? 'nav-link active' : 'nav-link' %>">Bookings</a>
        <% } %>
        
        <% if (user.email === 'dakshchaudhary10009@gmail.com') { %>
          <a href="/admin/manage-hosts" class="<%= currentPage === 'manage-hosts' ? 'nav-link active' : 'nav-link' %>">Manage Hosts</a>
        <% } %>
      <% } %>
    </div>

    <div class="nav-actions">
      <!-- Theme Toggle (Sirf Desktop par dikhega) -->
      <button class="theme-toggle desktop-item text-slate-800 dark:text-slate-100 p-2 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 transition" type="button" data-theme-toggle aria-label="Toggle dark mode">
        <svg class="dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 1.25rem; height: 1.25rem;">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="hidden dark:inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 1.25rem; height: 1.25rem;">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>

      <% if (!isLoggedIn) { %>
        <a href="/signup" class="nav-button secondary desktop-item">Sign Up</a>
        <a href="/login" class="nav-button primary desktop-item">Login</a>
      <% } else { %>
        <!-- Hi, User aur Logout (Sirf Desktop par dikhega) -->
        <span class="user-greeting desktop-item" aria-label="Signed in user">
          <span class="user-avatar" aria-hidden="true"><%= user.firstName ? user.firstName.charAt(0).toUpperCase() : 'U' %></span>
          <span>Hi, <strong><%= user.firstName %></strong></span>
        </span>
        <form action="/logout" method="POST" class="inline desktop-item -2">
          <button type="submit" class="nav-button secondary">Logout</button>
        </form>
      <% } %>

      <% if (isLoggedIn && user) { %>
        <span class="mobile-top-avatar user-avatar" aria-label="Signed in as <%= user.firstName %>"><%= user.firstName ? user.firstName.charAt(0).toUpperCase() : 'U' %></span>
      <% } %>
    </div>
  </nav>

</header>

<div class="mobile-menu-backdrop" data-mobile-menu-backdrop></div>
<!-- Kept outside the blurred header so its fixed positioning uses the viewport. -->
<aside class="mobile-menu" data-mobile-menu aria-hidden="true" aria-label="Mobile navigation">
    <div class="mobile-menu-header">
      <a href="/" class="nav-brand">
        <span class="brand-mark">N</span>
        <span class="font-extrabold">NestStay</span>
      </a>
      <button class="mobile-menu-close" type="button" data-mobile-menu-close aria-label="Close menu">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <% if (isLoggedIn && user) { %>
      <div class="mobile-user">
        <span class="user-avatar" aria-hidden="true"><%= user.firstName ? user.firstName.charAt(0).toUpperCase() : 'U' %></span>
        <div><span class="mobile-user-label">Signed in as</span><strong><%= user.firstName %></strong></div>
      </div>
    <% } %>

    <nav class="mobile-menu-links">
    <a href="/" class="nav-link">Home</a>
    <% if (isLoggedIn && user) { %>
      <% if (user.userType === 'host') { %>
        <a href="/host/host-home-list" class="nav-link">Host Dashboard</a>
        <a href="/host/add-home" class="nav-link">Add Home</a>
        <a href="/host/bookings" class="nav-link">Host Bookings</a>
      <% } %>
      <% if (user.userType === 'guest') { %>
        <a href="/favourites" class="nav-link">Favourites</a>
        <a href="/bookings" class="nav-link">Bookings</a>
      <% } %>
      <% if (user.email === 'dakshchaudhary10009@gmail.com') { %>
        <a href="/admin/manage-hosts" class="nav-link">Manage Hosts</a>
      <% } %>

      <button type="button" class="nav-link mobile-theme-toggle" data-mobile-theme-toggle>
  <!-- आइकॉन को भी डायनामिक बनाने के लिए id दी गई है -->
        <i id="mobile-theme-icon" class="fas fa-moon" aria-hidden="true"></i>
        <span id="mobile-theme-text">Dark Mode</span>
      </button>
      
      <form action="/logout" method="POST" class="mobile-logout">
        <button type="submit" class="nav-button secondary w-full text-left">Logout</button>
      </form>
    <% } else { %>
      <a href="/signup" class="nav-button secondary w-full mb-2">Sign Up</a>
      <a href="/login" class="nav-button primary w-full">Login</a>
    <% } %>
    </nav>
  </aside>

<div class="toast-root" aria-live="polite" aria-atomic="true"></div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
  const mobileThemeToggle = document.querySelector('[data-mobile-theme-toggle]');
  const themeText = document.getElementById('mobile-theme-text');
  const themeIcon = document.getElementById('mobile-theme-icon');

  // फंक्शन जो चेक करेगा कि डार्क मोड ऑन है या ऑफ
  function updateThemeUI() {
    // आमतौर पर डार्क मोड के लिए <html> या <body> टैग पर 'dark' क्लास लगाई जाती है
    const isDarkMode = document.documentElement.classList.contains('dark');

    if (isDarkMode) {
      themeText.textContent = 'Light Mode'; // डार्क मोड में Light Mode का ऑप्शन दिखाएं
      themeIcon.className = 'fas fa-sun';   // सूरज का आइकॉन
    } else {
      themeText.textContent = 'Dark Mode';  // लाइट मोड में Dark Mode का ऑप्शन दिखाएं
      themeIcon.className = 'fas fa-moon';  // चांद का आइकॉन
    }
  }

  if (mobileThemeToggle) {
    // जब यूजर बटन पर क्लिक करेगा
    mobileThemeToggle.addEventListener('click', () => {
      // यहां आपका पुराना थीम टॉगल करने वाला लॉजिक चलेगा (जैसे डार्क क्लास ऐड/रिमूव करना)
      // उदाहरण के लिए: document.documentElement.classList.toggle('dark');
      
      // थोड़ी देर बाद UI को अपडेट करें ताकि क्लास टॉगल हो चुकी हो
      setTimeout(updateThemeUI, 50); 
    });
  }

  // पेज लोड होते ही एक बार UI सेट कर दें
  updateThemeUI();
});
</script>

