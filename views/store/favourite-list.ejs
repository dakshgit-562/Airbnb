<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page-shell container mx-auto py-10">
  <div class="list-heading">
    <div>
      <p class="text-sm uppercase tracking-[0.3em] text-slate-500">Your collection</p>
      <h1 class="section-title">Saved favourites</h1>
      <p class="section-subtitle">Quick access to the homes you love.</p>
    </div>
  </div>

  <% if (favouriteHomes && favouriteHomes.length > 0) { %>
    <div class="card-grid mt-8">
      <% favouriteHomes.forEach(home => { %>
        
        <article class="property-card" style="position: relative; cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease;" onmouseover="this.style.transform='scale(1.02)'; this.style.boxShadow='0 10px 15px -3px rgb(0 0 0 / 0.1)'" onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='none'">
          
          <a href="/homes/<%= home._id %>" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 10;"></a>

          <div class="card-image-wrap">
              <img src="<%= home.photoUrl || '/images/OIP4.jpg' %>" alt="<%= home.houseName %>" />
          </div>
          
          <div class="card-content">
            <p class="badge-pill" style="margin-bottom: 8px;"><%= home.location %></p>
            
            <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
              
              <h3 class="card-title" style="margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 10px;">
                <%= home.houseName %>
              </h3>
              
              <form action="/favourites/delete/<%= home._id %>" method="POST" style="margin: 0; position: relative; z-index: 20;">
                <button type="submit" style="background-color: #ffe4e6; color: #e11d48; border: none; padding: 6px 12px; border-radius: 9999px; font-size: 0.75rem; font-weight: bold; cursor: pointer; transition: background 0.2s; display: flex; align-items: center; gap: 4px;" onmouseover="this.style.backgroundColor='#fecdd3'" onmouseout="this.style.backgroundColor='#ffe4e6'">
                  <i class="fas fa-trash-alt"></i> Remove
                </button>
              </form>

            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state mt-8">
      <h2>Your favourite stays will appear here.</h2>
      <p>Add homes to your favourites and keep them ready for planning.</p>
      <a href="/homes" class="btn-primary mt-4 inline-flex justify-center">Explore Homes</a>
    </div>
  <% } %>
</main>

</body>
</html>