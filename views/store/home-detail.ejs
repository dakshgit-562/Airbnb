<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<!-- Yahan se layout aur image fix ki gayi hai (Baaki poora logic same hai) -->
<main class="page-shell container mx-auto py-10 px-4 md:px-0">
  
  <div class="mb-6">
    <a href="/homes" class="nav-button secondary">Back to homes</a>
  </div>

  <!-- Ye raha Image Tag (Isse image perfect size mein aayegi) -->
  <div class="detail-hero-media mb-8">
    <img 
      src="<%= home.photoUrl || '/images/OIP4.jpg' %>" 
      alt="<%= home.houseName %>" 
      class="w-full h-full object-cover" 
    />
  </div>

  <div class="detail-layout">
    <div class="detail-summary">
      <div class="flex items-center justify-between gap-4 mb-4">
        <div>
          <p class="text-sm uppercase tracking-[0.3em] text-slate-500">
            Premium stay
          </p>

          <h2 class="text-3xl font-bold">
            <%= home.houseName %>
          </h2>

          <!-- BOOKING STATUS LOGIC ADDED HERE -->
          <div class="mt-2">
            <% if (home.isBooked) { %>
              <span class="status-badge status-booked">Booked</span>
            <% } else { %>
              <span class="status-badge status-available">Booking available</span>
            <% } %>
          </div>
          <!-- END LOGIC -->

        </div>

        <span class="badge">
          <i class="fas fa-star"></i>
          <%= home.rating %>
        </span>
      </div>

      <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
        <%= home.description || 'A beautifully styled stay with premium amenities and a peaceful neighbourhood.' %>
      </p>

      <div class="detail-facts grid gap-3 mt-6">
        <div class="field-group">
          <span class="text-sm font-semibold text-slate-500 uppercase tracking-[0.25em]">
            Location
          </span>

          <p class="text-base text-slate-700 dark:text-slate-200">
            <%= home.location %>
          </p>
        </div>

        <div class="field-group">
          <span class="text-sm font-semibold text-slate-500 uppercase tracking-[0.25em]">
            Price per night
          </span>

          <p class="text-2xl font-extrabold text-slate-900 dark:text-white">
            Rs <%= home.price %>
          </p>
        </div>
        <div class="field-group">
        <span class="text-sm font-semibold text-slate-500 uppercase tracking-[0.25em]">
          Host Contact
        </span>
        <p class="text-base font-bold text-slate-800 dark:text-slate-100">
          📞 <%= home.hostPhone || 'Not Available' %>
        </p>
      </div>
      </div>

      <% if (isLoggedIn && user && user.userType === 'guest') { %>

        <!-- Favourite -->
        <form action="/favourites" method="POST" class="mt-4">
          <input type="hidden" name="id" value="<%= home._id %>" />
          <button type="submit" class="heart-button w-full">
            <span>
              <i class="fas fa-heart heart-icon"></i>
              Save to favourites
            </span>
          </button>
        </form>

        <!-- Booking Summary -->
        <div class="detail-summary booking-card mt-6">
          <h3 class="text-xl font-semibold mb-3">
            Booking summary
          </h3>

          <form action="/bookings" method="POST" class="grid gap-3" id="booking-form">
            <input type="hidden" name="homeId" value="<%= home._id %>" />

            <div class="field-group">
              <label class="text-sm text-slate-500">Property</label>
              <p class="font-semibold"><%= home.houseName %></p>
            </div>

            <div class="field-group">
              <label class="text-sm text-slate-500">Price per night</label>
              <p class="font-semibold">Rs <%= home.price %></p>
            </div>

            <div class="field-group">
              <label class="text-sm text-slate-500" for="check-in">Check-in</label>
              <input id="check-in" name="checkIn" type="date" class="w-full" min="<%= new Date().toISOString().slice(0,10) %>" required />
            </div>

            <div class="field-group">
              <label class="text-sm text-slate-500" for="check-out">Check-out</label>
              <input id="check-out" name="checkOut" type="date" class="w-full" required />
            </div>

            <div class="field-group">
              <label class="text-sm text-slate-500">Number of nights</label>
              <p id="nights-count" class="font-semibold">0 nights</p>
            </div>

            <div class="field-group">
              <label class="text-sm text-slate-500">Total price</label>
              <p id="total-price" class="font-semibold">Rs 0</p>
            </div>

            <!-- SUBMIT BUTTON LOGIC ADDED HERE -->
            <% if (home.isBooked) { %>
                <button id="booking-submit" type="button" class="btn-primary w-full mt-4 pointer-events-none bg-slate-800  text-white" disabled>
                      Already Booked
                </button>
            <% } else { %>
              <button id="booking-submit" type="submit" class="btn-primary w-full mt-4">
                Confirm Booking
              </button>
            <% } %>
            <!-- END LOGIC -->

          </form>

          <script>
            (function () {
              const pricePerNight = Number(<%= home.price %>);
              const checkInInput = document.getElementById('check-in');
              const checkOutInput = document.getElementById('check-out');
              const nightsCount = document.getElementById('nights-count');
              const totalPrice = document.getElementById('total-price');

              function getDateValue(input) {
                return input && input.value ? new Date(input.value + 'T00:00:00') : null;
              }

              function updateSummary() {
                const checkInDate = getDateValue(checkInInput);
                const checkOutDate = getDateValue(checkOutInput);

                if (!checkInDate || !checkOutDate || checkOutDate <= checkInDate) {
                  nightsCount.textContent = '0 nights';
                  totalPrice.textContent = 'Rs 0';
                  return;
                }

                const nights = Math.round((checkOutDate - checkInDate) / (1000 * 60 * 60 * 24));
                nightsCount.textContent = `${nights} night${nights === 1 ? '' : 's'}`;
                totalPrice.textContent = `Rs ${pricePerNight * nights}`;
              }

              if (checkInInput && checkOutInput) {
                checkInInput.addEventListener('change', updateSummary);
                checkOutInput.addEventListener('change', updateSummary);
              }
            })();
          </script>
        </div>
      <% } %>
    </div>
  </div>
</main>
