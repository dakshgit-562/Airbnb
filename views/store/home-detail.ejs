<%- include('../partials/head') %>
<%- include('../partials/nav') %>


<main class="page-shell hd-wrapper">
  
  <!-- Back Button -->
  <div style="margin-bottom: 1.5rem;">
    <a href="/homes" class="nav-button secondary" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.2rem;">
      <i class="fas fa-arrow-left"></i> Back to homes
    </a>
  </div>

  <!-- Hero Image -->
  <div class="detail-hero-media" style="width: 100%; height: 700px; border-radius: 1.5rem; overflow: hidden; box-shadow: var(--card-shadow);">
    <img 
      src="<%= home.photoUrl || '/images/OIP4.jpg' %>" 
      alt="<%= home.houseName %>" 
      style="width: 100%; height: 100%; object-fit: cover;"
    />
  </div>

  <!-- Main Grid Layout -->
  <div class="hd-layout">
    
    <!-- 🏠 LEFT COLUMN (Details) -->
    <div>
      
      <!-- 🛠️ FIX 1: Removed badge-pill class to remove the map pin icon -->
      <span style="display: inline-block; background: var(--surface-strong); color: var(--muted); padding: 0.35rem 0.85rem; border-radius: 999px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">
        ✨ Premium stay
      </span>
      
      <h1 class="hd-title"><%= home.houseName %></h1>
      
      <!-- 🛠️ FIX 2: Added margin-right instead of gap so they never stick together -->
      <div style="display: flex; align-items: center; flex-wrap: wrap;">
        <span class="status-badge status-available" style="margin-right: 1.2rem; padding: 0.4rem 0.8rem; font-size: 0.8rem;">
          Booking available
        </span>
        <span class="status-badge" style="background: var(--accent-soft); color: var(--accent-strong); padding: 0.4rem 0.8rem; font-size: 0.8rem;">
          <i class="fas fa-star" style="margin-right: 0.3rem;"></i> <%= home.rating %>
        </span>
      </div>

      <!-- Info Grid (Location, Price, Host) -->
      <div class="hd-info-grid">
        <div>
          <span class="hd-label">Location</span>
          <!-- 🛠️ FIX 3: Icon alignment fixed for multi-line address -->
          <span class="hd-value"><i class="fas fa-map-marker-alt text-accent" style="margin-top: 0.25rem;"></i> <%= home.location %></span>
        </div>
        <div>
          <span class="hd-label">Price per night</span>
          <span class="hd-value">Rs <%= home.price %></span>
        </div>
        <div>
          <span class="hd-label">Host Contact</span>
          <span class="hd-value"><i class="fas fa-phone-alt text-accent" style="margin-top: 0.25rem;"></i> <%= home.hostPhone || 'Not Available' %></span>
        </div>
      </div>

      <!-- Description -->
      <div style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 1rem;">About this home</h2>
        <p style="color: var(--muted); line-height: 1.8; font-size: 1.05rem;">
          <%= home.description || 'A beautifully styled stay with premium amenities and a peaceful neighbourhood. Perfect for your next getaway.' %>
        </p>
      </div>
    </div>

    <!-- 💳 RIGHT COLUMN (Booking Card) -->
    <div style="position: relative;">
      <div class="hd-booking-card">
        
        <% if (isLoggedIn && user && user.userType === 'guest') { %>
          
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h3 style="font-size: 1.5rem; font-weight: 800; margin: 0;">Rs <%= home.price %> <span style="font-size: 1rem; font-weight: 500; color: var(--muted);">/ night</span></h3>
            
            <form action="/favourites" method="POST" style="margin: 0;">
              <input type="hidden" name="id" value="<%= home._id %>" />
              <button type="submit" class="heart-button" style="padding: 0.6rem; border-radius: 50%; width: 2.8rem; height: 2.8rem; border: 1px solid var(--border);">
                <i class="fas fa-heart heart-icon"></i>
              </button>
            </form>
          </div>

          <!-- Unavailable Dates Warning -->
          <% if (typeof bookings !== 'undefined' && bookings.length > 0) { %>
            <div style="background: var(--accent-soft); border: 1px solid rgba(255,56,92,0.2); padding: 1rem; border-radius: 0.75rem; margin-bottom: 1.5rem;">
              <h4 style="color: var(--accent-strong); font-size: 0.9rem; font-weight: 700; margin: 0 0 0.5rem 0;">
                <i class="fas fa-calendar-times"></i> Unavailable Dates
              </h4>
              <ul style="color: var(--accent-strong); font-size: 0.85rem; margin: 0; padding-left: 1.2rem;">
                <% bookings.forEach(booking => { %>
                  <li style="margin-bottom: 0.25rem;">
                    <strong><%= new Date(booking.checkIn).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %></strong> 
                    <span style="opacity: 0.7; margin: 0 0.2rem;">to</span> 
                    <strong><%= new Date(booking.checkOut).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %></strong>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% } %>

          <!-- Booking Form -->
          <form action="/bookings" method="POST" id="booking-form">
            <input type="hidden" name="homeId" value="<%= home._id %>" />

            <!-- Airbnb Style Inputs -->
            <div class="hd-inputs-container">
              <div class="hd-input-box">
                <label class="hd-label" style="font-size: 0.65rem;" for="check-in">Check-in</label>
                <input id="check-in" name="checkIn" type="date" class="hd-input-field" min="<%= new Date().toISOString().slice(0,10) %>" required />
              </div>
              <div class="hd-input-box">
                <label class="hd-label" style="font-size: 0.65rem;" for="check-out">Check-out</label>
                <input id="check-out" name="checkOut" type="date" class="hd-input-field" required />
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; color: var(--muted); font-size: 0.95rem; margin-bottom: 1rem;">
              <span style="text-decoration: underline;">Total nights</span>
              <span id="nights-count" style="font-weight: 500;">0 nights</span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 1.25rem; border-top: 1px solid var(--border); margin-bottom: 1.5rem;">
              <span style="font-weight: 600;">Total price</span>
              <span id="total-price" style="font-size: 1.2rem; font-weight: 800;">Rs 0</span>
            </div>

            <button type="submit" class="btn-primary" style="width: 100%;">
              Confirm Booking
            </button>
          </form>

          <script>
            (function () {
              const pricePerNight = Number('<%= home.price %>');
              const checkInInput = document.getElementById('check-in');
              const checkOutInput = document.getElementById('check-out');
              const nightsCount = document.getElementById('nights-count');
              const totalPrice = document.getElementById('total-price');

              function getDateValue(input) { return input && input.value ? new Date(input.value + 'T00:00:00') : null; }

              function updateSummary() {
                const checkInDate = getDateValue(checkInInput);
                const checkOutDate = getDateValue(checkOutInput);

                if (!checkInDate || !checkOutDate || checkOutDate <= checkInDate) {
                  nightsCount.textContent = '0 nights';
                  totalPrice.textContent = 'Rs 0';
                  return;
                }
                const nights = Math.round((checkOutDate - checkInDate) / (1000 * 60 * 60 * 24));
                nightsCount.textContent = `${nights} night${nights === 1 ? '' : 's'}`;
                totalPrice.textContent = `Rs ${pricePerNight * nights}`;
              }

              if (checkInInput && checkOutInput) {
                checkInInput.addEventListener('change', updateSummary);
                checkOutInput.addEventListener('change', updateSummary);
              }
            })();
          </script>

        <% } else if (!isLoggedIn) { %>
          <div style="text-align: center; padding: 1rem 0;">
            <h3 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 0.5rem;">Ready to book?</h3>
            <p style="color: var(--muted); font-size: 0.95rem; margin-bottom: 1.5rem;">Please log in as a guest to book this premium home.</p>
            <a href="/login" class="btn-primary" style="display: block; width: 100%; text-decoration: none; margin-bottom: 1rem;">Log in to Book</a>
            <p style="font-size: 0.9rem; color: var(--muted);">
              Don't have an account? <a href="/signup" style="color: var(--accent-strong); font-weight: bold; text-decoration: underline;">Sign up</a>
            </p>
          </div>
        <% } %>

      </div>
    </div>

  </div>
</main>