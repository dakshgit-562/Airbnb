<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page-shell container mx-auto py-10">
  <section class="list-heading">
    <div>
      <p class="text-sm uppercase tracking-[0.3em] text-slate-500">Curated collection</p>
      <h1 class="section-title">Explore premium homes</h1>
      <p class="section-subtitle">A beautifully refined home for every travel style.</p>
    </div>
    <span class="badge"><%= registeredHomes.length %> homes</span>
  </section>
  <aside class="hero-card">
      <div class="hero-card-header">
        <p class="text-sm uppercase tracking-[0.25em] text-slate-500">Search stays</p>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Start your journey</h2>
      </div>

      <form action="/homes" method="GET" class="search-row">
        <label class="search-field">
          <span>Destination</span>
          <div class="input-surface">
            <i class="fas fa-map-marker-alt"></i>
            <input type="text" name="destination" placeholder="Kuala Lumpur" aria-label="Destination" />
          </div>
        </label>

        
        <button type="submit" class="btn-primary search-action">SEARCH</button>
      </form>
    </aside>
  </section>

  

  <% if (registeredHomes.length > 0) { %>
    <div class="card-grid mt-8">
      <% registeredHomes.forEach(home => { %>
        
        <!-- पूरे कार्ड को Anchor Tag में रैप कर दिया गया है -->
        <a href="/homes/<%= home._id %>" style="text-decoration: none; color: inherit; display: block;">
          <article class="property-card" style="cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease;" onmouseover="this.style.transform='scale(1.02)'; this.style.boxShadow='0 10px 15px -3px rgb(0 0 0 / 0.1)'" onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='none'">
            <div class="card-image-wrap">
              <img src="<%= home.photoUrl || '/images/OIP4.jpg' %>" alt="<%= home.houseName %>" />
            </div>
            <div class="card-content">
              <!-- BOOKING STATUS LOGIC -->
              <div class="mb-2">
                <% if (home.isBooked) { %>
                  <span class="status-badge status-booked ">Booked</span>
                <% } else { %>
                  <span class="status-badge status-available ">Available</span>
                <% } %>
              </div>
              <!-- END LOGIC -->

              <p class="badge-pill"><%= home.location %></p>
              <h3 class="card-title"><%= home.houseName %></h3>
              
              <!-- View Details बटन को यहाँ से हटा दिया गया है -->

            </div>
          </article>
        </a>

      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state mt-8">
      <h2>Nothing found yet</h2>
      <p>Be the first to check out new homes arriving soon. Try adjusting your search filters.</p>
      <a href="/" class="btn-primary mt-4 inline-flex justify-center">Back to home</a>
    </div>
  <% } %>
</main>

</body>
</html>
