<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page-shell container mx-auto py-10">
  <section class="list-heading">
    <div>
      <p class="text-sm uppercase tracking-[0.3em] text-slate-500">Curated collection</p>
      <h1 class="section-title">Explore premium homes</h1>
      <p class="section-subtitle">A beautifully refined home for every travel style.</p>
    </div>
    <span class="badge"><%= registeredHomes.length %> homes</span>
  </section>

  <% if (registeredHomes.length > 0) { %>
    <div class="card-grid mt-8">
      <% registeredHomes.forEach(home => { %>
        <article class="property-card">
          <div class="card-image-wrap">
            <img src="<%= home.photoUrl || '/images/OIP4.jpg' %>" alt="<%= home.houseName %>" />
          </div>
          <div class="card-content">
            <!-- BOOKING STATUS LOGIC ADDED HERE -->
            <div class="mb-3">
              <% if (home.isBooked) { %>
                <span class="text-xs font-bold text-red-700 bg-red-100 px-2 py-1 rounded">🚨 Booked</span>
              <% } else { %>
                <span class="text-xs font-bold text-green-700 bg-green-100 px-2 py-1 rounded">✅ Not Booked yet</span>
              <% } %>
            </div>
            <!-- END LOGIC -->

            <p class="badge-pill"><%= home.location %></p>
            <h3 class="card-title"><%= home.houseName %></h3>
            <p class="text-sm text-slate-600 dark:text-slate-400 mb-4"><%= home.description || 'Modern stay with thoughtfully curated amenities and elegant comfort.' %></p>
            <div class="card-meta">
              <span><i class="fas fa-star text-amber-400"></i> <%= home.rating %></span>
              <span>Rs <strong><%= home.price %></strong> / night</span>
            </div>
            <div class="property-actions">
              <a class="btn-primary text-green-500 hover:text-green-600" href="/homes/<%= home._id %>">View Details</a>
              <% if (isLoggedIn && user && user.userType === 'guest') { %>
                <form action="/favourites" method="POST">
                  <input type="hidden" name="id" value="<%= home._id %>" />
                  <button type="submit" class="heart-button"><span><i class="fas fa-heart heart-icon"></i> Save</span></button>
                </form>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state mt-8">
      <h2>Nothing found yet</h2>
      <p>Be the first to check out new homes arriving soon. Try adjusting your search filters.</p>
      <a href="/" class="btn-primary mt-4 inline-flex justify-center">Back to home</a>
    </div>
  <% } %>
</main>

</body>
</html>