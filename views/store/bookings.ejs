<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="page-shell container mx-auto py-10">
  <!-- Page Header -->
  <div class="list-heading">
    <div>
      <p class="text-sm uppercase tracking-[0.3em] text-slate-500">Booking dashboard</p>
      <h1 class="section-title">My bookings</h1>
      <p class="section-subtitle">Track your upcoming stays and reservation details.</p>
    </div>
  </div>
  <!-- 🔍 SEARCH BAR CODE -->
<div style="margin-bottom: 24px; padding: 16px; background-color: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
  <form action="/host/bookings" method="GET" style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
    
    <div style="flex-grow: 1; max-width: 400px;">
      <input 
        type="text" 
        name="email" 
        value="<%= typeof searchEmail !== 'undefined' ? searchEmail : '' %>" 
        placeholder="Search Guest Email (e.g. daksh@gmail.com)" 
        style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 6px; outline: none;"
      >
    </div>

    <button type="submit" style="background-color: #e11d48; color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">
      Search
    </button>

    <% if (typeof searchEmail !== 'undefined' && searchEmail) { %>
      <a href="/host/bookings" style="padding: 10px 20px; background-color: #94a3b8; color: white; text-decoration: none; border-radius: 6px; font-weight: bold;">
        Clear
      </a>
    <% } %>
    
  </form>
</div>
  <% if (bookings && bookings.length > 0) { %>
    <section class="mt-8 space-y-6">
      <% bookings.forEach((booking) => { %>
        <!-- Booking Card -->
        <article class="card p-6 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
          
          <!-- Top Section: Property Name & Status -->
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="text-sm uppercase tracking-[0.3em] text-slate-500">Property</p>
              <h2 class="text-xl font-semibold text-slate-900 dark:text-white mt-1">
                <%= booking.home?.houseName || 'Unknown property' %>
              </h2>
            </div>
            <div class="text-left sm:text-right">
              <p class="text-sm uppercase tracking-[0.3em] text-slate-500 mb-2 sm:mb-1">Status</p>
              <!-- Checking status to apply correct badge color -->
              <span class="badge <%= booking.status === 'cancelled' ? 'badge-error' : 'badge' %>">
                <%= booking.status %>
              </span>
            </div>
          </div>

          <!-- Middle Section: Check-in / Check-out / Nights -->
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div>
              <span class="text-sm uppercase tracking-[0.25em] text-slate-500">Check-in</span>
              <p class="mt-2 font-medium text-slate-900 dark:text-slate-200"><%= booking.checkIn.toDateString() %></p>
            </div>
            <div>
              <span class="text-sm uppercase tracking-[0.25em] text-slate-500">Check-out</span>
              <p class="mt-2 font-medium text-slate-900 dark:text-slate-200"><%= booking.checkOut.toDateString() %></p>
            </div>
            <div>
              <span class="text-sm uppercase tracking-[0.25em] text-slate-500 mt-2">Nights: <p class="mt-2 font-medium text-slate-900 dark:text-slate-200"><%= booking.numberOfNights %></p></span>
            </div>
          </div>

          <!-- Bottom Section: Pricing & Booking Date -->
          <div class="mt-6 grid gap-4 sm:grid-cols-3">
            <div>
              <span class="text-sm uppercase tracking-[0.25em] text-slate-500">Price / night</span>
              <p class="mt-2 font-medium text-slate-900 dark:text-slate-200">Rs <%= booking.pricePerNight %></p>
            </div>
            <div>
              <span class="text-sm uppercase tracking-[0.25em] text-slate-500">Total price</span>
              <p class="mt-2 font-semibold text-lg text-slate-900 dark:text-white">Rs <%= booking.totalPrice %></p>
            </div>
            <div>
              <span class="text-sm uppercase tracking-[0.25em] text-slate-500">Booked on</span>
              <p class="mt-2 font-medium text-slate-900 dark:text-slate-200"><%= booking.createdAt.toDateString() %></p>
            </div>
          </div>

          <!-- Action Button -->
          <% if (booking.status !== 'cancelled') { %>
            <form action="/bookings/cancel/<%= booking._id %>" method="POST" class="mt-6 pt-4 border-t border-slate-200 dark:border-slate-800">
              <button type="submit" class="btn-danger">Cancel booking</button>
            </form>
          <% } %>
        </article>
      <% }) %>
    </section>
  <% } else { %>
    <!-- Empty State -->
    <div class="empty-state mt-8">
      <h2>You haven't made any bookings yet.</h2>
      <p>When you book a stay, your trip details will appear here with easy access to your itinerary.</p>
      <a href="/homes" class="btn-primary mt-4 inline-flex justify-center">Browse homes</a>
    </div>
  <% } %>
</main>

</body>
</html>